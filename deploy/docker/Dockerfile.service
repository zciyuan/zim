# syntax=docker/dockerfile:1.7

# Optional per-service image. Build with:
#   docker build -f deploy/docker/Dockerfile.service --build-arg SERVICE=zim-gate .
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY zimfw/go.mod zimfw/go.sum ./zimfw/
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
ARG SERVICE=zim-gate
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w \
        -X github.com/zciyuan/ZIM/internal/version.Version=${VERSION} \
        -X github.com/zciyuan/ZIM/internal/version.Commit=${COMMIT} \
        -X github.com/zciyuan/ZIM/internal/version.BuildTime=${BUILD_TIME}" \
      -o /out/zim-server ./cmd/${SERVICE}

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/zim-server /app/zim-server
WORKDIR /app
ENTRYPOINT ["/app/zim-server"]
