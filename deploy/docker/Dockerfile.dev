# Local development image. Production uses Dockerfile (distroless).

FROM golang:1.27-alpine AS deps
ENV GOPROXY=https://goproxy.cn,direct \
    GOSUMDB=off
WORKDIR /src
COPY go.mod go.sum ./
COPY zimfw/go.mod zimfw/go.sum ./zimfw/
RUN --mount=type=cache,target=/go/pkg/mod go mod download

FROM deps AS build
COPY . .
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w \
        -X github.com/zciyuan/ZIM/internal/version.Version=${VERSION} \
        -X github.com/zciyuan/ZIM/internal/version.Commit=${COMMIT} \
        -X github.com/zciyuan/ZIM/internal/version.BuildTime=${BUILD_TIME}" \
      -o /out/ ./cmd/...

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -g 65532 -S app \
    && adduser -u 65532 -S -G app app \
    && mkdir -p /app/run \
    && chown -R 65532:65532 /app
COPY --from=build --chown=65532:65532 /out/ /app/
WORKDIR /app
USER 65532:65532
# No ENTRYPOINT: the compose service selects /app/zim-* via command.

